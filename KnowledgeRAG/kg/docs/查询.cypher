// =====================================================
// Graph 模式展示查询脚本（扩展版）
// 功能：查询图斑 → 指数（植被/土壤） → 时间尺度（年/季/月） → 恢复阶段
// 说明：用于可视化知识图谱的完整结构
// =====================================================

// ① 主体：空间区域 → 图斑
MATCH (r:空间区域 {名称:'九寨沟滑坡区'})-[:包含图斑]->(tb:图斑)

// ② 图斑 → 时间尺度（年/季/月）
OPTIONAL MATCH (tb)-[:观测于]->(t:时间尺度)

// ③ 图斑 → 对应生态阶段（滑坡前/滑坡后/恢复中/已恢复）
OPTIONAL MATCH (tb)-[:对应状态]->(s:状态)

// ④ 滑坡系统 → 植被/土壤 → 遥感指数
MATCH (land:实体 {名称:'滑坡'})-[:包含实体]->(sub:实体)
WHERE sub.名称 IN ['植被','土壤']
MATCH (sub)-[:监测指标]->(i:指数)

// ⑤ 建立 "图斑–指数" 与 "图斑–时间尺度–指数" 联结关系（仅当不存在时创建）
MERGE (tb)-[:观测指数]->(i)
MERGE (tb)-[:在时间尺度观测 {粒度:t.时间单位}]->(i)

// ⑥ 输出用于 Graph 可视化的完整结构
RETURN 
  r, tb, t, s, land, sub, i
ORDER BY tb.ID, sub.名称;

