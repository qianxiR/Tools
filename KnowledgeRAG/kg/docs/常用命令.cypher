// =====================================================
// Neo4j 常用命令脚本
// 功能：提供数据库管理、查询、统计等常用操作
// =====================================================

// =====================================================
// 一、数据库信息查询
// =====================================================

// 查询所有节点标签
CALL db.labels();

// 查询所有关系类型
CALL db.relationshipTypes();

// 查询所有属性键
CALL db.propertyKeys();

// 查询数据库统计信息
CALL db.stats();

// =====================================================
// 二、节点和关系统计
// =====================================================

// 查看当前节点数量
MATCH (n) RETURN count(n) AS 节点数;

// 查看当前关系数量
MATCH ()-[r]->() RETURN count(r) AS 关系数;

// 按标签统计节点数量
MATCH (n)
RETURN labels(n) AS 节点类型, count(n) AS 数量
ORDER BY 数量 DESC;

// 按类型统计关系数量
MATCH ()-[r]->()
RETURN type(r) AS 关系类型, count(r) AS 数量
ORDER BY 数量 DESC;

// =====================================================
// 三、数据清理操作（谨慎使用）
// =====================================================

// ⚠️ 删除数据库中所有节点与关系（危险操作）
// MATCH (n)
// DETACH DELETE n;

// 删除特定标签的所有节点
// MATCH (n:图斑)
// DETACH DELETE n;

// 删除特定关系类型
// MATCH ()-[r:观测指数]->()
// DELETE r;

// =====================================================
// 四、常用查询示例
// =====================================================

// 查询所有实体
MATCH (e:实体)
RETURN e.名称 AS 实体名称
ORDER BY e.名称;

// 查询所有指数及其含义
MATCH (i:指数)
RETURN i.名称 AS 指数名称, i.含义 AS 含义
ORDER BY i.名称;

// 查询所有状态及其顺序
MATCH (s:状态)
RETURN s.名称 AS 状态名称, s.顺序 AS 顺序, s.语义 AS 语义
ORDER BY s.顺序;

// 查询实体与指数的监测关系
MATCH (e:实体)-[:监测指标]->(i:指数)
RETURN e.名称 AS 实体, collect(i.名称) AS 监测指数
ORDER BY e.名称;

// 查询图斑及其关联信息
MATCH (tb:图斑)
OPTIONAL MATCH (tb)-[:对应状态]->(s:状态)
OPTIONAL MATCH (tb)-[:观测于]->(t:时间尺度)
RETURN tb.ID AS 图斑ID, tb.数据源 AS 数据源, 
       collect(DISTINCT s.名称) AS 状态, 
       collect(DISTINCT t.名称) AS 时间尺度
ORDER BY tb.ID;

// =====================================================
// 五、约束管理
// =====================================================

// 查看所有约束
SHOW CONSTRAINTS;

// 删除约束（示例）
// DROP CONSTRAINT constraint_name;

// =====================================================
// 六、索引管理
// =====================================================

// 查看所有索引
SHOW INDEXES;

// 创建索引（示例）
// CREATE INDEX FOR (n:图斑) ON (n.ID);

// 删除索引（示例）
// DROP INDEX index_name;

